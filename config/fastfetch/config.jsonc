{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "height": 15,
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": "  ",
      "format": "{6}{7}{8}",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "╭───────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{name} {arch}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏗 Pkgs",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────┤"
    },
    {
      "type": "de",
      "key": "  󰧨 DE",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Term",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "  󰏘 Font",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "  󰸌 Theme",
      "keyColor": "green",
      "text": "cat ~/.config/.current-theme 2>/dev/null || echo 'none'"
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": "  󰊴 GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "   Mem",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "yellow",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "  󰍹 Res",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle"
    }
  ]
}
