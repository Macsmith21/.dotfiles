[global]
    origin = top-right
    offset = (16, 16)
    width = (280, 380)
    height = (0, 120)
    notification_limit = 4
    gap_size = 8

    frame_width = 2
    frame_color = "#28282890"
    corner_radius = 12
    separator_height = 0
    separator_color = auto
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    transparency = 15

    font = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end

    show_age_threshold = -1
    idle_threshold = 0
    show_indicators = false
    progress_bar = false
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 8
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

    layer = overlay
    force_xwayland = false
    indicate_hidden = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#28282890"
    foreground = "#EBDBB2"
    highlight = "#458588"
    timeout = 4

[urgency_normal]
    background = "#28282890"
    foreground = "#EBDBB2"
    highlight = "#98971A"
    timeout = 6

[urgency_critical]
    background = "#28282890"
    foreground = "#EBDBB2"
    highlight = "#CC241D"
    timeout = 0
