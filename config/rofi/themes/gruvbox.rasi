* {
    bg:         #282828CC;
    bg-alt:     #3C3836CC;
    fg:         #EBDBB2;
    fg-alt:     #928374;
    accent:     #83A598;
    urgent:     #FB4934;

    background-color: transparent;
    text-color: @fg;
    spacing: 0;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 600px;
    padding: 0;
}

inputbar {
    background-color: @bg-alt;
    padding: 12px 16px;
    border-radius: 12px 12px 0 0;
    children: [prompt, entry];
    spacing: 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 8;
    padding: 8px 0;
    scrollbar: false;
}

element {
    padding: 10px 16px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
    border-radius: 0;
}

element-icon {
    size: 24px;
    margin: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
}
